# ──────────────────────────────────────────────────────────────────────────────
# GotoDM – Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://gotodm:changeme@localhost:5432/gotodm
POSTGRES_USER=gotodm
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gotodm

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-very-long-random-jwt-secret-here

# ── Encryption (for storing Instagram tokens) ─────────────────────────────────
# Must be exactly 32 characters
TOKEN_ENCRYPTION_KEY=a-32-char-secret-for-aes-encrypt

# ── Meta / Instagram ──────────────────────────────────────────────────────────
INSTAGRAM_APP_ID=your_meta_app_id
INSTAGRAM_APP_SECRET=your_meta_app_secret
# Must match the redirect URI registered in the Meta Developer Console
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/instagram/callback
# A random string you configure in Meta's webhook settings
WEBHOOK_VERIFY_TOKEN=your-random-webhook-verify-token

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_AGENCY=price_...

# ── Frontend (Next.js public vars) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_KEY=pk_test_...

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
